  "engineered_features": [
    {
      "feature": "GPA_Change",
      "formula": "Post_Semester_GPA - Pre_Semester_GPA",
      "meaning": "Measures semester-level academic movement."
    },
    {
      "feature": "GPA_Drop_Flag",
      "formula": "1 if GPA_Change < 0 else 0",
      "meaning": "Flags students whose GPA fell during the semester."
    },
    {
      "feature": "Total_Learning_Hours",
      "formula": "Weekly_GenAI_Hours + Traditional_Study_Hours",
      "meaning": "Captures total weekly learning workload."
    },
    {
      "feature": "AI_to_Study_Time_Ratio",
      "formula": "Weekly_GenAI_Hours / (Traditional_Study_Hours + 1)",
      "meaning": "Compares AI-supported work against traditional study time."
    },
    {
      "feature": "Dependency_Adjusted_AI_Usage",
      "formula": "Weekly_GenAI_Hours * Perceived_AI_Dependency",
      "meaning": "Combines usage intensity with self-reported dependency."
    },
    {
      "feature": "Anxiety_Dependency_Interaction",
      "formula": "Anxiety_Level_During_Exams * Perceived_AI_Dependency",
      "meaning": "Captures the combined wellbeing risk signal from anxiety and AI dependency."
    },
    {
      "feature": "Skill_Retention_Per_AI_Hour",
      "formula": "Skill_Retention_Score / (Weekly_GenAI_Hours + 1)",
      "meaning": "Estimates retained skill relative to AI usage intensity."
    },
    {
      "feature": "High_AI_Use_Flag",
      "formula": "1 if Weekly_GenAI_Hours is above the 75th percentile else 0",
      "meaning": "Marks unusually high GenAI usage."
    },
    {
      "feature": "Low_Skill_Retention_Flag",
      "formula": "1 if Skill_Retention_Score is below the 25th percentile else 0",
      "meaning": "Marks comparatively weak skill retention."
    },
    {
      "feature": "Early_Warning_Risk_Index",
      "formula": "z(AI hours) + z(dependency) + z(anxiety) - z(traditional hours) - z(pre-semester GPA)",
      "meaning": "Combines early-available risk and protective signals."
    }
  ],
